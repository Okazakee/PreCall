{
  "name": "@okazakee/precall",
  "version": "0.1.0",
  "description": "Provider-neutral TypeScript library for privacy-filtered service-intake pre-call briefs.",
  "keywords": [
    "precall",
    "service-intake",
    "intake",
    "ai",
    "typescript",
    "email"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okazakee/PreCall.git"
  },
  "bugs": {
    "url": "https://github.com/Okazakee/PreCall/issues"
  },
  "homepage": "https://github.com/Okazakee/PreCall#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "import": "./dist/resend.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome check --write . && oxlint --fix .",
    "lint:ci": "biome check . && oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build": "tsdown",
    "package:check": "bun scripts/check-package.ts",
    "release:check": "bun scripts/check-release.ts",
    "release:dry-run": "bun scripts/release-dry-run.ts",
    "live-ai:check": "bun scripts/live-ai.ts",
    "live-email:check": "bun scripts/live-email.ts",
    "check:repo": "bun scripts/check-repo.ts",
    "check": "bun run check:repo && bun run format:check && bun run lint:ci && bun run typecheck && bun run test && bun run build && bun run package:check"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "1.2.9",
    "langsmith": ">=0.5.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "langsmith": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@langchain/core": "1.2.9",
    "@langchain/openai": "1.5.11",
    "bun-types": "1.3.14",
    "langsmith": "0.10.1",
    "npm": "11.14.1",
    "oxlint": "^1.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}

{
  "name": "precall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome check --write . && oxlint --fix .",
    "lint:ci": "biome check . && oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build": "tsdown",
    "package:check": "bun scripts/check-package.ts",
    "check:repo": "bun scripts/check-repo.ts",
    "check": "bun run check:repo && bun run format:check && bun run lint:ci && bun run typecheck && bun run test && bun run build && bun run package:check"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "bun-types": "1.3.14",
    "oxlint": "^1.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
